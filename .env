# ===== Pembayaran QRIS Kasera (/buy) =====
# Kosong = /buy dimatikan
KASERA_API_KEY=
KASERA_BASE_URL=https://pay.kasera.id
KASERA_WEBHOOK_SECRET=
# Port webhook (0 = tanpa webhook, hanya polling)
WEBHOOK_PORT=0
